  box-shadow: 0 0 22px rgba(255, 24, 56, 0.07);
}

.help-icon {
  color: var(--neon-hot);
  text-shadow: 0 0 12px var(--neon-red);
}

/* API Reference */
.api-reference {
  color: var(--text);
}

.api-reference h1,
.api-reference h2,
.api-reference h3 {
  color: #fff0f2;
}

