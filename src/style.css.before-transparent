    inset 2px 0 #ff1838,
    0 0 18px rgba(255, 24, 56, 0.10);
}

.nav-item.active .nav-indicator {
  background: #ff3652;
  box-shadow: 0 0 8px #ff1838, 0 0 18px #ff1838;
}

.status-dot {
  background: #ff3652;
  box-shadow: 0 0 10px #ff1838;
}

/* Main documentation area */
.main-content {
  background: transparent;
}

.article h1,
.section-heading h2 {
  color: #fff1f3;
}

.article-eyebrow,
.eyebrow-line,
.section-number {
  color: var(--neon-hot);
}

.eyebrow-line {
  background: var(--neon-red);
