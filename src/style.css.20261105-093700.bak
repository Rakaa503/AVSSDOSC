@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #e5eaf5;
  background: #090b12;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  --bg: #090b12;
  --surface: #0e121d;
  --surface-raised: #111827;
  --border: #20283b;
  --border-soft: #192235;
  --text: #e5eaf5;
  --muted: #929db2;
  --subtle: #647087;
  --blue: #3b82f6;
  --cyan: #54d8ff;
  --mono: 'DM Mono', monospace;
  --heading: 'Space Grotesk', sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: var(--bg);
}

button,
input {
  font: inherit;
}

button {
  color: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

button:focus-visible,
a:focus-visible,
input:focus-visible {
  outline: 2px solid var(--cyan);
  outline-offset: 3px;
}

#app {
  min-height: 100vh;
}

.docs-shell {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 48% -25%, rgba(37, 99, 235, 0.09), transparent 50%),
    var(--bg);
}

.topbar {
  height: 68px;
  position: sticky;
  z-index: 50;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  padding: 0 36px;
  background: rgba(9, 11, 18, 0.88);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(18px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 205px;
}

.brand-mark {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border: 1px solid rgba(84, 216, 255, 0.45);
  border-radius: 9px;
  background: linear-gradient(145deg, #173a70, #101c35);
  box-shadow: 0 0 22px rgba(59, 130, 246, 0.15);
}

.brand-mark span {
  color: var(--cyan);
  font-family: var(--heading);
  font-size: 20px;
  font-weight: 700;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.brand-copy strong {
  font-family: var(--heading);
  font-size: 16px;
  letter-spacing: -0.6px;
}

.brand-copy strong span {
  color: var(--cyan);
}

.brand-copy small {
  color: var(--subtle);
  font-family: var(--mono);
  font-size: 8px;
  letter-spacing: 1.1px;
}

.topbar-center {
  display: flex;
  align-items: center;
  gap: 11px;
  color: var(--muted);
  font-size: 12px;
}

.topbar-divider {
  color: #38445a;
}

.topbar-current {
  color: #dce5f5;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 17px;
}

.search-box {
  display: flex;
  align-items: center;
  width: 245px;
  height: 35px;
  gap: 9px;
  padding: 0 9px;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: #0d121d;
  color: var(--muted);
}

.search-icon {
  font-size: 20px;
}

.search-box input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  color: var(--text);
  background: transparent;
  font-size: 11px;
}

.search-box input::placeholder {
  color: #67738a;
}

.search-box kbd {
  flex-shrink: 0;
  padding: 3px 5px;
  border: 1px solid #2a3449;
  border-radius: 4px;
  color: #8c99af;
  font-family: var(--mono);
  font-size: 8px;
}

.version-badge {
  padding: 4px 7px;
  border: 1px solid rgba(59, 130, 246, 0.3);
  border-radius: 4px;
  background: rgba(59, 130, 246, 0.1);
  color: #78aaff;
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.5px;
}

.github-link {
  display: grid;
  width: 27px;
  height: 27px;
  place-items: center;
  border: 1px solid var(--border);
  border-radius: 6px;
  color: #b9c6db;
  font-size: 15px;
}

.github-link:hover {
  border-color: var(--blue);
  color: var(--cyan);
}

.mobile-menu-button {
  display: none;
  border: 0;
  background: transparent;
  font-size: 22px;
  cursor: pointer;
}

.docs-layout {
  display: grid;
  grid-template-columns: 248px minmax(0, 1fr) 218px;
  max-width: 1600px;
  min-height: calc(100vh - 68px);
  margin: 0 auto;
}

.left-sidebar {
  position: sticky;
  top: 68px;
  display: flex;
  height: calc(100vh - 68px);
  flex-direction: column;
  overflow-y: auto;
  padding: 32px 20px 20px 27px;
  border-right: 1px solid var(--border);
}

.sidebar-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28px;
  color: #77859e;
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 1.3px;
}

.sidebar-version {
  color: #45516a;
}

.nav-group {
  margin-bottom: 26px;
}

.nav-group h3 {
  margin: 0 0 11px 9px;
  color: #66748d;
  font-family: var(--mono);
  font-size: 9px;
  font-weight: 400;
  letter-spacing: 1.1px;
}

.nav-item {
  display: flex;
  width: 100%;
  min-height: 35px;
  align-items: center;
  gap: 11px;
  padding: 7px 10px;
  border: 0;
  border-radius: 5px;
  background: transparent;
  color: #929db2;
  text-align: left;
  font-size: 12px;
  cursor: pointer;
  transition: 160ms ease;
}

.nav-item:hover {
  background: rgba(59, 130, 246, 0.07);
  color: #d8e5f9;
}

.nav-item.active {
  background: rgba(59, 130, 246, 0.12);
  color: #8dbaff;
}

.nav-indicator {
  width: 5px;
  height: 5px;
  flex-shrink: 0;
  border-radius: 50%;
  background: #46536b;
}

.nav-item.active .nav-indicator {
  background: var(--cyan);
  box-shadow: 0 0 9px rgba(84, 216, 255, 0.6);
}

.sidebar-bottom {
  display: flex;
  flex-direction: column;
  gap: 13px;
  margin-top: auto;
  padding-top: 25px;
}

.status-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #8795ac;
  font-size: 10px;
}

.status-dot {
  width: 6px;
  height: 6px;
  flex-shrink: 0;
  border-radius: 50%;
  background: #40d6a0;
  box-shadow: 0 0 9px rgba(64, 214, 160, 0.45);
}

.sidebar-caption {
  color: #4d5a71;
  font-family: var(--mono);
  font-size: 8px;
  letter-spacing: 0.8px;
}

.empty-search {
  padding: 12px 8px;
  color: var(--muted);
  font-size: 11px;
}

.main-content {
  min-width: 0;
  padding: 34px clamp(28px, 5vw, 76px) 50px;
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 37px;
  color: #718099;
  font-size: 11px;
}

.breadcrumb-separator {
  color: #3b4960;
}

.breadcrumb span:last-child {
  color: #b5c2d7;
}

.article {
  width: 100%;
  max-width: 780px;
  margin: 0 auto;
}

.article-eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #8293b0;
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 1.5px;
}

.eyebrow-line {
  width: 18px;
  height: 1px;
  background: var(--cyan);
}

.article h1 {
  margin: 15px 0 9px;
  color: #f1f5fc;
  font-family: var(--heading);
  font-size: clamp(36px, 4vw, 48px);
  font-weight: 600;
  letter-spacing: -2px;
  line-height: 1.13;
}

.article-lead {
  max-width: 620px;
  margin: 0;
  color: #929eb3;
  font-size: 14px;
  line-height: 1.8;
}

.hero-panel {
  position: relative;
  display: flex;
  min-height: 310px;
  align-items: center;
  overflow: hidden;
  margin-top: 36px;
  padding: 34px 38px;
  border: 1px solid #263957;
  border-radius: 11px;
  background:
    linear-gradient(115deg, rgba(18, 39, 72, 0.98), rgba(13, 23, 43, 0.97) 58%, rgba(12, 22, 39, 0.98));
}

.hero-glow {
  position: absolute;
  top: -140px;
  right: -80px;
  width: 350px;
  height: 350px;
  border-radius: 50%;
  background: rgba(32, 125, 240, 0.12);
  filter: blur(70px);
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 440px;
}

.hero-tag {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #a7c3e8;
  font-family: var(--mono);
  font-size: 8px;
  letter-spacing: 1.1px;
}

.hero-tag .status-dot {
  background: var(--cyan);
  box-shadow: 0 0 9px rgba(84, 216, 255, 0.7);
}

.hero-content h2 {
  margin: 20px 0 11px;
  color: #f2f7ff;
  font-family: var(--heading);
  font-size: 43px;
  font-weight: 600;
  letter-spacing: -2px;
  line-height: 1.08;
}

.hero-content h2 span {
  color: var(--cyan);
}

.hero-content > p {
  max-width: 415px;
  color: #a6b6ce;
  font-size: 12px;
  line-height: 1.85;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 24px;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  min-height: 36px;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 0 14px;
  border: 1px solid transparent;
  border-radius: 5px;
  font-size: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: 160ms ease;
}

.primary-button {
  background: #2775e9;
  color: white;
}

.primary-button:hover {
  background: #3989ff;
  box-shadow: 0 5px 22px rgba(39, 117, 233, 0.2);
}

.secondary-button {
  border-color: #354b6c;
  background: rgba(9, 19, 36, 0.4);
  color: #c4d4eb;
}

.secondary-button:hover {
  border-color: #6ba8ff;
  color: white;
}

.hero-decoration {
  position: absolute;
  top: 0;
  right: 0;
  display: grid;
  width: 260px;
  height: 100%;
  place-items: center;
}

.shield-outer {
  position: relative;
  z-index: 2;
  display: grid;
  width: 116px;
  height: 132px;
  place-items: center;
  border: 1px solid rgba(84, 216, 255, 0.4);
  border-radius: 46% 46% 49% 49%;
  background: linear-gradient(145deg, rgba(46, 130, 238, 0.25), rgba(11, 30, 57, 0.7));
  box-shadow:
    0 0 35px rgba(40, 143, 255, 0.2),
    inset 0 0 25px rgba(84, 216, 255, 0.08);
  transform: rotate(0deg);
}

.shield-inner {
  display: grid;
  width: 80px;
  height: 94px;
  place-items: center;
  border: 1px solid rgba(84, 216, 255, 0.3);
  border-radius: 45% 45% 48% 48%;
  color: var(--cyan);
  font-size: 39px;
  text-shadow: 0 0 20px rgba(84, 216, 255, 0.8);
}

.orbit {
  position: absolute;
  width: 205px;
  height: 205px;
  border: 1px solid rgba(84, 216, 255, 0.13);
  border-radius: 50%;
}

.orbit-two {
  width: 245px;
  height: 245px;
  border-style: dashed;
  border-color: rgba(84, 216, 255, 0.1);
}

.decoration-label {
  position: absolute;
  bottom: 32px;
  color: #7294ba;
  font-family: var(--mono);
  font-size: 8px;
  letter-spacing: 2px;
}

.content-section {
  margin-top: 45px;
  scroll-margin-top: 95px;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 15px;
}

.section-number {
  color: #5a9bff;
  font-family: var(--mono);
  font-size: 10px;
}

.section-heading h2 {
  margin: 0;
  color: #e8edf7;
  font-family: var(--heading);
  font-size: 21px;
  font-weight: 600;
  letter-spacing: -0.6px;
}

.content-section > p {
  color: #9aa7bc;
  font-size: 12px;
  line-height: 1.95;
}

.info-callout {
  display: flex;
  gap: 13px;
  margin-top: 19px;
  padding: 16px;
  border: 1px solid rgba(59, 130, 246, 0.25);
  border-left: 2px solid var(--blue);
  border-radius: 5px;
  background: rgba(29, 78, 150, 0.09);
}

.callout-icon {
  display: grid;
  width: 19px;
  height: 19px;
  flex-shrink: 0;
  place-items: center;
  border: 1px solid #498de7;
  border-radius: 50%;
  color: #7bb4ff;
  font-size: 11px;
}

.info-callout strong {
  color: #b9d6ff;
  font-size: 11px;
}

.info-callout p {
  margin-top: 5px;
  color: #8f9fba;
  font-size: 11px;
  line-height: 1.8;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 11px;
  margin-top: 20px;
}

.feature-card {
  position: relative;
  display: flex;
  min-height: 135px;
  flex-direction: column;
  align-items: flex-start;
  gap: 9px;
  padding: 15px;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: linear-gradient(145deg, #111827, #0c111b);
  text-align: left;
  cursor: pointer;
  transition: 180ms ease;
}

.feature-card:hover {
  transform: translateY(-3px);
  border-color: #365c91;
  background: #111c2e;
}

.feature-icon {
  color: var(--cyan);
  font-family: var(--mono);
  font-size: 10px;
}

.feature-card strong {
  color: #dce6f6;
  font-size: 11px;
}

.feature-card > span:nth-of-type(2) {
  color: #8290a7;
  font-size: 10px;
  line-height: 1.6;
}

.feature-arrow {
  position: absolute;
  top: 13px;
  right: 14px;
  color: #7486a1;
  font-size: 13px;
}

.next-section {
  padding-bottom: 35px;
}

.next-section .primary-button {
  margin-top: 18px;
}

.placeholder-panel {
  margin-top: 35px;
  padding: 42px 30px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: linear-gradient(145deg, #111827, #0d121d);
}

.placeholder-icon {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  margin-bottom: 20px;
  border: 1px solid #315a91;
  border-radius: 8px;
  background: rgba(59, 130, 246, 0.1);
  color: var(--cyan);
  font-size: 22px;
}

.placeholder-panel h2 {
  margin: 0 0 12px;
  color: #e7edf8;
  font-family: var(--heading);
  font-size: 22px;
}

.placeholder-panel p {
  max-width: 500px;
  color: #9aa7bc;
  font-size: 12px;
  line-height: 1.8;
}

.placeholder-panel .placeholder-note {
  margin-top: 12px;
  color: #74849e;
}

.placeholder-panel .secondary-button {
  margin-top: 22px;
}

.article-footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 50px;
  padding-top: 18px;
  border-top: 1px solid var(--border);
  color: #56637a;
  font-family: var(--mono);
  font-size: 8px;
  letter-spacing: 0.8px;
}

.right-sidebar {
  position: sticky;
  top: 68px;
  display: flex;
  height: calc(100vh - 68px);
  flex-direction: column;
  padding: 42px 19px 20px;
  border-left: 1px solid var(--border);
}

.toc-container h3 {
  margin: 0 0 18px;
  color: #77859d;
  font-family: var(--mono);
  font-size: 9px;
  font-weight: 400;
  letter-spacing: 1px;
}

.toc-link {
  display: block;
  margin: 0 0 13px;
  padding-left: 11px;
  border-left: 1px solid #2b3548;
  color: #8f9cb1;
  font-size: 10px;
  transition: 150ms ease;
}

.toc-link:hover {
  border-left-color: var(--cyan);
  color: #c4d9f5;
}

.toc-empty {
  color: #6c7890;
  font-size: 10px;
  line-height: 1.7;
}

.right-sidebar-bottom {
  margin-top: auto;
}

.help-card {
  padding: 15px;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: linear-gradient(145deg, #111a2a, #0d121d);
}

.help-icon {
  display: block;
  margin-bottom: 12px;
  color: var(--cyan);
  font-size: 17px;
}

.help-card strong {
  color: #dce6f6;
  font-size: 11px;
}

.help-card p {
  margin-top: 7px;
  color: #8492a9;
  font-size: 10px;
  line-height: 1.7;
}

@media (max-width: 1150px) {
  .docs-layout {
    grid-template-columns: 225px minmax(0, 1fr);
  }

  .right-sidebar {
    display: none;
  }

  .main-content {
    padding-right: 42px;
    padding-left: 42px;
  }
}

@media (max-width: 760px) {
  .topbar {
    height: 62px;
    padding: 0 17px;
  }

  .brand {
    min-width: 0;
  }

  .topbar-center,
  .version-badge,
  .github-link {
    display: none;
  }

  .topbar-actions {
    gap: 10px;
  }

  .search-box {
    width: min(43vw, 210px);
    height: 33px;
  }

  .search-box kbd {
    display: none;
  }

  .mobile-menu-button {
    display: block;
  }

  .docs-layout {
    display: block;
    min-height: calc(100vh - 62px);
  }

  .left-sidebar {
    position: fixed;
    z-index: 45;
    top: 62px;
    bottom: 0;
    left: 0;
    width: 275px;
    height: auto;
    background: #0c111b;
    box-shadow: 15px 0 45px rgba(0, 0, 0, 0.3);
    transform: translateX(-110%);
    transition: transform 180ms ease;
  }

  .left-sidebar.mobile-open {
    transform: translateX(0);
  }

  .main-content {
    padding: 25px 20px 40px;
  }

  .breadcrumb {
    margin-bottom: 29px;
  }

  .article h1 {
    font-size: 37px;
  }

  .hero-panel {
    min-height: 340px;
    padding: 28px 22px;
  }

  .hero-content {
    max-width: 100%;
  }

  .hero-content h2 {
    font-size: 38px;
  }

  .hero-decoration {
    right: -95px;
    opacity: 0.28;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }

  .feature-card {
    min-height: 110px;
  }

  .article-footer {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

/* ==========================================
   AVSS LITE — RED NEON VISUAL IDENTITY
   ========================================== */

:root {
  color-scheme: dark;

  --bg: #070607;
  --surface: #100b0d;
  --surface-raised: #190d11;
  --border: #48202a;
  --border-soft: #29151b;

  --text: #f5edf0;
  --muted: #b7a5aa;
  --subtle: #79666c;

  --blue: #ff263f;
  --cyan: #ff5367;

  --neon-red: #ff1838;
  --neon-hot: #ff3652;
  --red-glow: rgba(255, 24, 56, 0.32);

  background: var(--bg);
  color: var(--text);
}

html {
  scrollbar-color: #9e1b31 #090607;
}

body {
  background: #070607;
  color: var(--text);
}

button:focus-visible,
a:focus-visible,
input:focus-visible {
  outline-color: var(--neon-hot);
}

.docs-shell {
  position: relative;
  isolation: isolate;
  background:
    radial-gradient(ellipse at 50% -20%, rgba(255, 24, 56, 0.13), transparent 55%),
    radial-gradient(ellipse at 100% 55%, rgba(160, 0, 30, 0.10), transparent 45%),
    #070607;
}

/* Animated ambient background */
.docs-shell::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: 0.32;
  background-image:
    linear-gradient(rgba(255, 30, 55, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 30, 55, 0.045) 1px, transparent 1px),
    radial-gradient(circle, rgba(255, 36, 59, 0.65) 1px, transparent 1.5px);
  background-size: 48px 48px, 48px 48px, 32px 32px;
  animation: avss-grid-drift 24s linear infinite;
}

@keyframes avss-grid-drift {
  from { background-position: 0 0, 0 0, 0 0; }
  to { background-position: 48px 48px, 48px 48px, 32px 32px; }
}

/* Top navigation */
.topbar {
  position: sticky;
  background: rgba(8, 6, 7, 0.94);
  border-bottom: 1px solid rgba(255, 24, 56, 0.35);
  box-shadow: 0 5px 28px rgba(255, 0, 40, 0.07);
  backdrop-filter: blur(18px);
}

.topbar::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 28%;
  height: 1px;
  background: linear-gradient(90deg, transparent, #ff1838, transparent);
  box-shadow: 0 0 12px #ff1838;
  animation: avss-light-sweep 7s ease-in-out infinite alternate;
}

@keyframes avss-light-sweep {
  from { transform: translateX(0); }
  to { transform: translateX(250%); }
}

.brand-mark {
  border-color: rgba(255, 40, 65, 0.7);
  background: linear-gradient(145deg, #310b14, #10080b);
  box-shadow: 0 0 22px rgba(255, 24, 56, 0.18);
}

.brand-mark span {
  color: var(--neon-hot);
  text-shadow: 0 0 14px var(--neon-red);
}

.brand-copy strong span,
.topbar-current {
  color: var(--neon-hot);
}

.search-box {
  border-color: var(--border);
  background: rgba(20, 10, 13, 0.85);
}

.search-box:focus-within {
  border-color: var(--neon-red);
  box-shadow: 0 0 18px rgba(255, 24, 56, 0.15);
}

.search-box kbd,
.version-badge {
  border-color: rgba(255, 24, 56, 0.35);
  color: var(--neon-hot);
  background: rgba(255, 24, 56, 0.07);
}

.github-link:hover,
.mobile-menu-button:hover {
  color: var(--neon-hot);
  border-color: var(--neon-red);
  box-shadow: 0 0 14px rgba(255, 24, 56, 0.16);
}

/* Sidebar */
.left-sidebar {
  background: rgba(9, 7, 8, 0.97);
  border-right-color: rgba(255, 24, 56, 0.19);
}

.nav-group h3,
.sidebar-caption {
  color: #96757d;
}

.nav-item {
  transition:
    color 0.25s ease,
    background 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.25s ease;
}

.nav-item:hover {
  color: #fff0f2;
  background: rgba(255, 24, 56, 0.075);
  transform: translateX(3px);
}

.nav-item.active {
  color: #fff;
  background: linear-gradient(100deg, rgba(255, 24, 56, 0.20), rgba(255, 24, 56, 0.035));
  box-shadow:
    inset 2px 0 #ff1838,
    0 0 18px rgba(255, 24, 56, 0.10);
}

.nav-item.active .nav-indicator {
  background: #ff3652;
  box-shadow: 0 0 8px #ff1838, 0 0 18px #ff1838;
}

.status-dot {
  background: #ff3652;
  box-shadow: 0 0 10px #ff1838;
}

/* Main documentation area */
.main-content {
  background: transparent;
}

.article h1,
.section-heading h2 {
  color: #fff1f3;
}

.article-eyebrow,
.eyebrow-line,
.section-number {
  color: var(--neon-hot);
}

.eyebrow-line {
  background: var(--neon-red);
  box-shadow: 0 0 12px var(--neon-red);
}

.section-heading {
  border-left: 3px solid var(--neon-red);
  padding-left: 15px;
}

.info-callout {
  border-color: rgba(255, 24, 56, 0.30);
  background: rgba(255, 24, 56, 0.055);
}

.callout-icon {
  background: rgba(255, 24, 56, 0.15);
  color: var(--neon-hot);
}

.feature-card {
  border-color: var(--border);
  background: linear-gradient(145deg, #160d10, #0b0809);
}

.feature-card:hover {
  border-color: rgba(255, 24, 56, 0.65);
  box-shadow: 0 8px 30px rgba(255, 24, 56, 0.12);
  transform: translateY(-4px);
}

.feature-icon,
.feature-arrow {
  color: var(--neon-hot);
}

.primary-button {
  background: linear-gradient(110deg, #d90e30, #ff2948);
  box-shadow: 0 0 20px rgba(255, 24, 56, 0.22);
}

.primary-button:hover {
  background: linear-gradient(110deg, #f0183b, #ff5267);
  box-shadow: 0 0 28px rgba(255, 24, 56, 0.4);
}

.secondary-button:hover {
  color: #fff;
  border-color: var(--neon-red);
  background: rgba(255, 24, 56, 0.08);
}

.placeholder-panel {
  border-color: var(--border);
  background: linear-gradient(145deg, #140b0e, #090708);
}

/* Right navigation */
.right-sidebar {
  border-left-color: rgba(255, 24, 56, 0.20);
  background: rgba(8, 6, 7, 0.38);
}

.toc-link:hover,
.toc-link.active {
  color: var(--neon-hot);
}

.help-card {
  border-color: rgba(255, 24, 56, 0.3);
  background: linear-gradient(145deg, rgba(35, 10, 16, 0.9), rgba(12, 8, 10, 0.95));
  box-shadow: 0 0 22px rgba(255, 24, 56, 0.07);
}

.help-icon {
  color: var(--neon-hot);
  text-shadow: 0 0 12px var(--neon-red);
}

/* API Reference */
.api-reference {
  color: var(--text);
}

.api-reference h1,
.api-reference h2,
.api-reference h3 {
  color: #fff0f2;
}

.api-reference a {
  color: var(--neon-hot);
}

.api-code-wrap {
  margin-top: 20px;
}

.api-code-heading {
  color: var(--neon-hot);
}

.api-code-heading span {
  border-left: 3px solid var(--neon-red);
  padding-left: 10px;
}

/* Selection and scrollbar */
::selection {
  color: #fff;
  background: rgba(255, 24, 56, 0.48);
}

* {
  scrollbar-width: thin;
  scrollbar-color: #782033 #0b0809;
}

/* Motion accessibility */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}


/* ===== AVSS LITE INSTALLATION REDESIGN ===== */

.install-card {
  padding: 26px;
  border: 1px solid #48202a;
  border-radius: 16px;
  background: linear-gradient(145deg, #160d12, #100b0d 65%);
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.install-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
}

.install-eyebrow {
  color: #ff5269;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.6px;
}

.install-card-header h4 {
  margin: 9px 0 6px;
  color: #fff;
  font-size: 23px;
  font-weight: 750;
}

.install-card-header p {
  margin: 0;
  color: #b7a5aa;
  font-size: 13px;
  line-height: 1.7;
}

.install-badge {
  padding: 7px 13px;
  border: 1px solid #71303c;
  border-radius: 7px;
  background: #30131b;
  color: #ff5269;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
}

.install-repository {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 15px 17px;
  border: 1px solid #38202a;
  border-radius: 10px;
  background: #0c090c;
}

.install-repository > span,
.api-code-heading {
  color: #a58e96;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 1.2px;
}

.install-repository a {
  width: fit-content;
  color: #ff667b;
  font-size: 13px;
  font-weight: 650;
  text-decoration: none;
}

.install-repository a:hover {
  color: #fff;
}

.install-card .api-code-wrap {
  margin: 0;
  overflow: hidden;
  border: 1px solid #38202a;
  border-radius: 11px;
  background: #09080b;
}

.install-card .api-code-heading {
  display: flex;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid #38202a;
}

.install-note {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 16px;
  border: 1px solid #48202a;
  border-radius: 9px;
  background: rgba(255, 24, 56, 0.055);
}

.install-note > span {
  display: grid;
  flex: 0 0 19px;
  height: 19px;
  place-items: center;
  border-radius: 50%;
  background: #48202a;
  color: #ff7185;
  font-size: 12px;
  font-weight: 800;
}

.install-note p {
  margin: 0;
  color: #c4b2b8;
  font-size: 12px;
  line-height: 1.7;
}

@media (max-width: 600px) {
  .install-card {
    padding: 18px;
    gap: 19px;
  }

  .install-card-header h4 {
    font-size: 20px;
  }
}

/* ===== END INSTALLATION REDESIGN ===== */


/* ===== API REFERENCE LAYOUT REPAIR ===== */

.api-reference {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  color: #f4edf0;
}

.api-reference * {
  box-sizing: border-box;
}

.api-reference-header {
  margin-bottom: 38px;
}

.api-reference-header h1 {
  margin: 0 0 14px;
  font-size: clamp(36px, 5vw, 58px);
  line-height: 1.1;
  letter-spacing: -1.8px;
}

.api-reference-header p {
  color: #a5a1b0;
  line-height: 1.7;
}

.api-reference-toolbar,
.api-category-list,
.api-category-tabs {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin: 22px 0 30px;
}

.api-reference button,
.api-reference [role="tab"] {
  padding: 9px 14px;
  border: 1px solid #402630;
  border-radius: 8px;
  background: #160e13;
  color: #d8cbd1;
  font-size: 13px;
  cursor: pointer;
  transition: .2s ease;
}

.api-reference button:hover,
.api-reference [role="tab"]:hover {
  border-color: #ff5269;
  color: #fff;
}

.api-reference button.active,
.api-reference button[aria-selected="true"],
.api-reference [role="tab"][aria-selected="true"] {
  border-color: #ff5269;
  background: rgba(255,82,105,.13);
  color: #ff8294;
}

.api-reference input {
  width: 100%;
  max-width: 320px;
  padding: 11px 14px;
  border: 1px solid #49303a;
  border-radius: 8px;
  outline: none;
  background: #100b0f;
  color: #fff;
}

.api-reference input:focus {
  border-color: #ff5269;
  box-shadow: 0 0 0 3px rgba(255,82,105,.1);
}

.api-reference .api-section {
  min-width: 0;
  margin: 0 0 42px;
}

.api-reference .api-section-heading {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
}

.api-reference .api-section-heading h3 {
  margin: 0;
  font-size: 26px;
  line-height: 1.3;
}

.api-reference .api-section-description {
  margin: 0 0 22px;
  color: #aaa1aa;
  font-size: 14px;
  line-height: 1.7;
}

.api-reference .api-entry {
  min-width: 0;
  margin: 18px 0;
  padding: 23px;
  border: 1px solid rgba(255,82,105,.2);
  border-radius: 13px;
  background: linear-gradient(145deg,#170e13,#100b0e);
}

.api-reference .api-entry-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}

.api-reference .api-entry-heading h4 {
  margin: 0;
  font-size: 18px;
}

.api-reference .api-entry-type {
  padding: 5px 10px;
  border: 1px solid #71303c;
  border-radius: 6px;
  color: #ff7185;
  font-size: 10px;
  font-weight: 800;
}

.api-reference .api-signature {
  overflow-x: auto;
  margin: 0 0 14px;
  padding: 15px;
  border: 1px solid #38232c;
  border-radius: 8px;
  background: #09080b;
  color: #ff9dad;
  overflow-wrap: anywhere;
}

.api-reference .api-entry-description {
  color: #b9aeb5;
  font-size: 13px;
  line-height: 1.7;
}

.api-reference .api-code-wrap {
  min-width: 0;
  margin-top: 18px;
  overflow: hidden;
  border: 1px solid #38232c;
  border-radius: 10px;
  background: #09080b;
}

.api-reference .api-code-heading {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 15px;
  border-bottom: 1px solid #38232c;
}

.api-reference .api-note {
  margin-top: 16px;
  padding: 14px;
  border-left: 3px solid #ff5269;
  border-radius: 6px;
  background: rgba(255,82,105,.07);
}

.api-reference .api-reference-footer {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 40px;
  padding-top: 20px;
  border-top: 1px solid #38232c;
  color: #95858e;
  font-size: 10px;
  letter-spacing: 1px;
}

@media (max-width: 700px) {
  .api-reference-header h1 {
    font-size: 36px;
  }

  .api-reference .api-entry {
    padding: 16px;
  }

  .api-reference .api-section-heading h3 {
    font-size: 21px;
  }
}

/* ===== END API REFERENCE LAYOUT REPAIR ===== */
/* ===== API REFERENCE HORIZONTAL LAYOUT V2 ===== */

.api-reference {
  width: 100%;
  min-width: 0;
}

.api-reference .api-intro {
  width: 100%;
  margin-bottom: 30px;
}

.api-reference .api-intro > p {
  max-width: 850px;
  margin: 14px 0 20px;
  color: #aaa1aa;
  font-size: 15px;
  line-height: 1.8;
}

.api-reference .api-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 20px;
}

.api-reference .api-meta > span {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border: 1px solid #38232c;
  border-radius: 6px;
  background: #130c11;
  color: #c4b5bd;
  font-size: 11px;
  line-height: 1.4;
}

.api-reference .api-meta .api-version {
  color: #ff7185;
  border-color: #71303c;
}

/* Categories become a horizontal navigation row */
.api-reference .api-browser {
  display: flex !important;
  flex-direction: column !important;
  align-items: stretch;
  gap: 30px;
  width: 100%;
  min-width: 0;
}

.api-reference .api-nav {
  display: flex !important;
  flex-direction: row !important;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  width: 100% !important;
  min-width: 0;
  padding: 0 0 22px;
  border: 0 !important;
  border-bottom: 1px solid #38232c !important;
  background: transparent !important;
}

.api-reference .api-nav-label {
  display: block;
  flex: 0 0 100%;
  margin-bottom: 5px;
  color: #ff7185;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.6px;
}

.api-reference .api-nav-item {
  display: inline-flex !important;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 42px;
  padding: 10px 16px !important;
  border: 1px solid #392630 !important;
  border-radius: 8px !important;
  background: #130d11 !important;
  color: #c9bdc4 !important;
  font-size: 13px !important;
  font-weight: 600;
  line-height: 1.4;
  cursor: pointer;
  transition: all .2s ease;
}

.api-reference .api-nav-item:hover {
  border-color: #ff5269 !important;
  color: #fff !important;
  transform: translateY(-1px);
}

.api-reference .api-nav-item.active {
  border-color: #ff5269 !important;
  background: rgba(255,82,105,.12) !important;
  color: #ff8294 !important;
}

.api-reference .api-nav-arrow {
  display: none !important;
}

/* Main content */
.api-reference .api-content {
  width: 100% !important;
  min-width: 0;
  flex: 1 1 auto;
}

.api-reference .api-content-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 22px;
}

.api-reference .api-overline {
  display: block;
  margin-bottom: 12px;
  color: #ff7185;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.api-reference .api-content-heading h2 {
  margin: 0 0 10px;
  color: #fff0f3;
  font-size: clamp(25px, 3vw, 34px);
  line-height: 1.2;
  letter-spacing: -.7px;
}

.api-reference .api-content-heading p {
  margin: 0;
  color: #a99da5;
  font-size: 14px;
  line-height: 1.7;
}

.api-reference .api-search {
  display: flex;
  align-items: center;
  gap: 12px;
  width: min(100%, 440px);
  margin: 0 0 28px;
}

.api-reference .api-search > span {
  color: #ff7185;
  font-size: 17px;
}

.api-reference .api-search input {
  width: 100%;
  min-width: 0;
  height: 44px;
  padding: 0 14px;
  border: 1px solid #49303a;
  border-radius: 8px;
  outline: none;
  background: #100b0f;
  color: #fff;
  font-size: 13px;
}

.api-reference .api-search input:focus {
  border-color: #ff5269;
  box-shadow: 0 0 0 3px rgba(255,82,105,.09);
}

.api-reference .api-section {
  width: 100%;
  margin: 0 0 38px;
}

.api-reference .api-section-heading {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 9px;
}

.api-reference .api-section-heading h3 {
  margin: 0;
  font-size: 22px;
  line-height: 1.4;
  color: #fff0f3;
}

.api-reference .api-section-description {
  margin: 0 0 20px;
  color: #a99da5;
  font-size: 13px;
  line-height: 1.7;
}

.api-reference .api-entry {
  width: 100%;
  min-width: 0;
  margin: 16px 0;
  padding: 22px;
  border: 1px solid rgba(255,82,105,.19);
  border-radius: 12px;
  background: linear-gradient(145deg,#170e13,#100b0e);
}

.api-reference .api-entry-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}

.api-reference .api-entry-heading h4 {
  margin: 0;
  font-size: 17px;
}

.api-reference .api-reference-footer {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 12px;
  margin-top: 40px;
  padding-top: 20px;
  border-top: 1px solid #38232c;
  color: #95858e;
  font-size: 10px;
  letter-spacing: 1px;
}

@media (max-width: 700px) {
  .api-reference .api-nav {
    gap: 8px;
  }

  .api-reference .api-nav-item {
    min-height: 38px;
    padding: 8px 11px !important;
    font-size: 11px !important;
  }

  .api-reference .api-entry {
    padding: 16px;
  }

  .api-reference .api-search {
    width: 100%;
  }
}

/* ===== END API REFERENCE HORIZONTAL LAYOUT V2 ===== */
